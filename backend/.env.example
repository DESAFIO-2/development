# Copie para .env e ajuste. NUNCA commite o .env.
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO

# Observabilidade (OpenTelemetry). Lidas direto do ambiente, por isso sem prefixo APP_.
# Com o Jaeger de observability/docker-compose.yml rodando, os traces aparecem em http://localhost:16686
FASTAPI_OTEL_AUTO_CONFIGURE=true
OTEL_SERVICE_NAME=sus-cidadao-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# O Jaeger só recebe traces; métricas e logs via OTLP ficam desligados por enquanto.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
