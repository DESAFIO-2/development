# Copie para .env e ajuste. NUNCA commite o .env.
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
# Origens Web liberadas via CORS (separadas por vírgula; vazio desabilita CORS).
APP_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Observabilidade (OpenTelemetry). Lidas direto do ambiente, por isso sem prefixo APP_.
# Com o Jaeger de observability/docker-compose.yml rodando, os traces aparecem em http://localhost:16686
FASTAPI_OTEL_AUTO_CONFIGURE=true
OTEL_SERVICE_NAME=sus-cidadao-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# O Jaeger só recebe traces; métricas e logs via OTLP ficam desligados por enquanto.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Somente para o runner experimental; a API de auditoria continua determinística.
APP_LLM_PROVIDER=gemini
APP_LLM_MODEL_NAME=
APP_GOOGLE_API_KEY=
APP_OLLAMA_BASE_URL=http://localhost:11434

# Agentes Semana 4: modo explícito; não troca de provedor automaticamente.
APP_AGENTS_PROVIDER=deterministic
APP_AGENTS_MODEL=qwen3.5:4b
APP_AGENTS_TIMEOUT_SECONDS=60
# Para geração local (padrão recomendado em máquina local): APP_AGENTS_PROVIDER=ollama.
# Para plugar API externa (MLOps/Deploy): definir APP_AGENTS_PROVIDER=gemini,
# APP_AGENTS_MODEL=<modelo-flash> e APP_GOOGLE_API_KEY=<sua-chave>.

# --- Segurança da API (ver docs/security/autenticacao.md) ----------------------
# Fora de APP_ENVIRONMENT=local, login obrigatório, rate limit e /docs fechado
# ligam sozinhos, e a API NÃO SOBE sem banco e os dois segredos abaixo.
# Para forçar no local: APP_AUTH_OBRIGATORIA=true / APP_RATE_LIMIT_ATIVO=true.
# APP_AUTH_OBRIGATORIA=
# APP_RATE_LIMIT_ATIVO=
# APP_EXPOR_DOCS=
# Banco de usuários (make db-up). Vazio no local = usuários em memória.
APP_DATABASE_URL=
# Segredos: gere cada um com  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazios no local = aleatórios a cada subida (sessões caem ao reiniciar).
# Trocar o PEPPER invalida todos os cadastros: guarde-o como guarda o banco.
APP_AUTH_JWT_SECRET=
APP_AUTH_CPF_PEPPER=
