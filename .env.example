# ==============================================================================
# SUS CIDADÃO (NAVEGASUS) - ENVIRONMENT CONFIGURATION (REFERÊNCIA RAIZ)
# ==============================================================================
# Para rodar a API localmente, copie `backend/.env.example` para `backend/.env`.
# As configurações da aplicação usam prefixo `APP_` (ver `backend/app/core/config.py`).

APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO

# Observabilidade (OpenTelemetry -> Jaeger em observability/docker-compose.yml)
FASTAPI_OTEL_AUTO_CONFIGURE=true
OTEL_SERVICE_NAME=sus-cidadao-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Diretórios de Dados (opcionais; padrão aponta para ./data)
APP_DATA_RAW_DIR=./data/raw
APP_DATA_PROCESSED_DIR=./data/processed
APP_DATA_MANIFESTS_DIR=./data/manifests

# Provedores de IA (apenas experimento / etapas generativas)
APP_LLM_PROVIDER=gemini
APP_LLM_MODEL_NAME=
APP_GOOGLE_API_KEY=
APP_OPENAI_API_KEY=
APP_ANTHROPIC_API_KEY=
APP_OLLAMA_BASE_URL=http://localhost:11434

# Parâmetros RAG
APP_RAG_FAITHFULNESS_THRESHOLD=0.92
APP_RAG_TOP_K=5
