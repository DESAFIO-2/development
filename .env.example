# ==============================================================================
# SUS CIDADÃO (NAVEGASUS) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Providers
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""

# Embeddings & Vector Store
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
VECTOR_STORE_PATH="./data/vectorstore/chroma"

# Data Directories
DATA_RAW_DIR="./data/raw"
DATA_STAGING_DIR="./data/staging"
DATA_PROCESSED_DIR="./data/processed"
DATA_MANIFESTS_DIR="./data/manifests"

# Application Settings
ENVIRONMENT="development"
LOG_LEVEL="INFO"
API_HOST="0.0.0.0"
API_PORT=8000
UI_PORT=8501

# Observability (OpenTelemetry / Langfuse)
OTEL_EXPORTER_OTLP_ENDPOINT=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# RAG & Guardrail Thresholds
RAG_FAITHFULNESS_THRESHOLD=0.92
RAG_TOP_K=5
